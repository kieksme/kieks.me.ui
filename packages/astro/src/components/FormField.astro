---
interface Props { id:string;label:string;hint?:string;error?:string;required?:boolean;class?:string }
const {id,label,hint,error,required=false,class:className=''}=Astro.props;
---
<div class:list={['ui-field',{'ui-field-invalid':!!error},className]}><label for={id} class="ui-field-label">{label}{required&&<span aria-hidden="true"> *</span>}</label><slot />{hint&&<p id={`${id}-hint`} class="ui-field-hint">{hint}</p>}{error&&<p id={`${id}-error`} class="ui-field-error">{error}</p>}</div>
