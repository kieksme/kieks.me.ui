---
import type { HTMLAttributes } from 'astro/types';
export type Props = HTMLAttributes<'aside'> & { title?: string; text?: string };
const { title, text, class: className, ...attributes } = Astro.props;
---
<aside {...attributes} class:list={['ui-note', className]}>{title && <strong>{title}</strong>}{text && <p>{text}</p>}<slot /></aside>
