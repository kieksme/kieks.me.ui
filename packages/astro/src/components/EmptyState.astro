---
interface Props {title:string;description?:string;class?:string}
const {title,description,class:className=''}=Astro.props;
---
<section class:list={['ui-empty',className]}><h2>{title}</h2>{description&&<p>{description}</p>}<slot />{Astro.slots.has('actions')&&<div class="ui-empty-actions"><slot name="actions" /></div>}</section>
