---
/** KI offer card with 22px left color edge — SPEC §4.3 */
export interface Props {
  title: string;
  description: string;
  edge: 'aqua' | 'fuchsia' | 'purple' | 'navy';
  shadow?: 'aqua' | 'fuchsia' | 'purple' | 'navy';
  class?: string;
}

const { title, description, edge, shadow = edge === 'navy' ? 'fuchsia' : edge, class: className = '' } = Astro.props;

const colors = {
  aqua: 'var(--pop-aqua)',
  fuchsia: 'var(--pop-fuchsia)',
  navy: 'var(--pop-navy)',
  purple: 'var(--pop-purple)',
};
---

<article
  class:list={['pop-feature-card flex overflow-hidden bg-[var(--surface)] border-[3px] border-[var(--ink)]', className]}
  style={`box-shadow: 8px 8px 0 0 ${colors[shadow]};`}
>
  <span class="w-[22px] shrink-0 self-stretch" style={`background: ${colors[edge]};`} aria-hidden="true"></span>
  <div class="flex flex-col gap-2.5 pt-6 pb-[26px] px-6">
    <h3 class="font-heading font-extrabold text-2xl leading-[30px]" style="color: var(--text-primary);">{title}</h3>
    <p class="text-lg leading-7" style="color: var(--text-secondary);">{description}</p>
  </div>
</article>

<style>
  .pop-feature-card {
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .pop-feature-card:hover {
    transform: translate(-3px, -3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .pop-feature-card:hover {
      transform: none;
    }
  }
</style>

<!-- Utility rules extracted from kieks.me Tailwind 3; consumer independent. -->
<style>
@layer kieksme-website-reset {
:where(*) { box-sizing: border-box; }
:where([class*="border"]) { border-style: solid; border-width: 0; }
:where(h1,h2,h3,h4,p,figure) { margin: 0; }
:where(button) { background: transparent; text-align: inherit; font: inherit; }
:where(a) { text-decoration: inherit; }
}

@layer kieksme-website-utilities {
.flex {
    display: flex
}
.w-\[22px\] {
    width: 22px
}
.shrink-0 {
    flex-shrink: 0
}
.transform {
    transform: translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y))
}
.flex-col {
    flex-direction: column
}
.gap-2\.5 {
    gap: 0.625rem
}
.self-stretch {
    align-self: stretch
}
.overflow-hidden {
    overflow: hidden
}
.border-\[3px\] {
    border-width: 3px
}
.border-\[var\(--ink\)\] {
    border-color: var(--ink)
}
.bg-\[var\(--surface\)\] {
    background-color: var(--surface)
}
.px-6 {
    padding-left: 1.5rem;
    padding-right: 1.5rem
}
.pb-\[26px\] {
    padding-bottom: 26px
}
.pt-6 {
    padding-top: 1.5rem
}
.font-heading {
    font-family: var(--aw-font-heading, "Hanken Grotesk"), ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji"
}
.text-2xl {
    font-size: 1.5rem;
    line-height: 2rem
}
.text-lg {
    font-size: 1.125rem;
    line-height: 1.75rem
}
.font-extrabold {
    font-weight: 800
}
.leading-7 {
    line-height: 1.75rem
}
.leading-\[30px\] {
    line-height: 30px
}
.shadow {
    --tw-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
    --tw-shadow-colored: 0 1px 3px 0 var(--tw-shadow-color), 0 1px 2px -1px var(--tw-shadow-color);
    box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow)
}
.transition {
    transition-property: color, background-color, border-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 150ms
}
}
</style>
