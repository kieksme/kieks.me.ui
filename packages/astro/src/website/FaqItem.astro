---
import Marker from './Marker.astro';

export interface Props {
  title: string;
  color?: 'aqua' | 'fuchsia' | 'purple' | 'navy';
  open?: boolean;
  class?: string;
}

const { title, color = 'aqua', open = true, class: className = '' } = Astro.props;
---

<details
  class:list={['pop-faq-item py-6 border-b-[3px] border-[var(--ink)] group', className]}
  open={open || undefined}
>
  <summary class="flex gap-5 items-start cursor-pointer list-none">
    <Marker variant="diamond" color={color} class="pop-faq-diamond mt-1.5" />
    <span class="font-heading font-extrabold text-2xl leading-[30px]" style="color: var(--text-primary);">{title}</span>
  </summary>
  <div class="mt-2 pl-[38px] text-lg leading-7" style="color: var(--text-secondary);">
    <slot />
  </div>
</details>

<style>
  .pop-faq-item summary::-webkit-details-marker {
    display: none;
  }
  .pop-faq-item[open] :global(.pop-faq-diamond) {
    transform: rotate(45deg) !important;
  }
</style>

<!-- Utility rules extracted from kieks.me Tailwind 3; consumer independent. -->
<style>
@layer kieksme-website-reset {
:where(*) { box-sizing: border-box; }
:where([class*="border"]) { border-style: solid; border-width: 0; }
:where(h1,h2,h3,h4,p,figure) { margin: 0; }
:where(button) { background: transparent; text-align: inherit; font: inherit; }
:where(a) { text-decoration: inherit; }
}

@layer kieksme-website-utilities {
.mt-1\.5 {
    margin-top: 0.375rem
}
.mt-2 {
    margin-top: 0.5rem
}
.flex {
    display: flex
}
.transform {
    transform: translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y))
}
.cursor-pointer {
    cursor: pointer
}
.list-none {
    list-style-type: none
}
.items-start {
    align-items: flex-start
}
.gap-5 {
    gap: 1.25rem
}
.border-b-\[3px\] {
    border-bottom-width: 3px
}
.border-\[var\(--ink\)\] {
    border-color: var(--ink)
}
.py-6 {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem
}
.pl-\[38px\] {
    padding-left: 38px
}
.font-heading {
    font-family: var(--aw-font-heading, "Hanken Grotesk"), ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji"
}
.text-2xl {
    font-size: 1.5rem;
    line-height: 2rem
}
.text-lg {
    font-size: 1.125rem;
    line-height: 1.75rem
}
.font-extrabold {
    font-weight: 800
}
.leading-7 {
    line-height: 1.75rem
}
.leading-\[30px\] {
    line-height: 30px
}
}
</style>
