---
import cardHalftone from './assets/653-21_service-card__imgGroup.svg?url';
import TextLink from './TextLink.astro';

export interface Props {
  num: string;
  title: string;
  description: string;
  href: string;
  linkText: string;
  headColor: 'aqua' | 'fuchsia' | 'purple' | 'navy';
  shadow?: 'ink' | 'fuchsia';
  numShadow?: 'fuchsia' | 'aqua';
  numColor?: string;
  class?: string;
}

const {
  num,
  title,
  description,
  href,
  linkText,
  headColor,
  shadow = 'ink',
  numShadow = 'fuchsia',
  numColor,
  class: className = '',
} = Astro.props;

const heads = {
  aqua: 'var(--pop-aqua)',
  fuchsia: 'var(--pop-fuchsia)',
  purple: 'var(--pop-purple)',
  navy: 'var(--pop-navy)',
};
const shadowColor = shadow === 'fuchsia' ? 'var(--pop-fuchsia)' : 'var(--ink)';
const nShadow = numShadow === 'aqua' ? 'var(--pop-aqua)' : 'var(--pop-fuchsia)';
const nColor = numColor ?? (headColor === 'purple' || headColor === 'navy' ? '#fff' : 'var(--pop-navy)');
---

<article
  class:list={['pop-service-card flex flex-col bg-[var(--surface)] border-[3px] border-[var(--ink)]', className]}
  style={`--pop-card-shadow-color: ${shadowColor};`}
  lang="de"
>
  <div
    class="relative h-[132px] overflow-hidden border-b-[3px] border-[var(--ink)] pl-6 pt-[18px] max-md:h-auto max-md:w-[84px] max-md:shrink-0 max-md:border-b-0 max-md:border-r-[3px] max-md:flex max-md:justify-center max-md:pl-0 max-md:pt-[14px] max-md:pb-4"
    style={`background: ${heads[headColor]};`}
  >
    <div
      class="absolute left-[120px] top-0 h-[132px] w-[300px] opacity-25 pointer-events-none max-md:hidden"
      aria-hidden="true"
    >
      <img src={cardHalftone} alt="" class="w-full h-full object-cover" width="300" height="132" />
    </div>
    <span
      class="pop-service-card__number relative font-heading font-black text-[80px] leading-[normal] max-md:text-[40px]"
      style={`color: ${nColor}; --pop-number-shadow-color: ${nShadow};`}
    >
      {num}
    </span>
  </div>
  <div
    class="pop-service-card__body flex flex-col gap-3 px-6 pt-[22px] pb-[26px] flex-1 max-md:gap-2 max-md:px-4 max-md:pt-4 max-md:pb-[18px]"
  >
    <h3 class="pop-service-card__title font-heading font-extrabold" style="color: var(--text-primary);">{title}</h3>
    <p class="text-lg leading-7" style="color: var(--text-secondary);">{description}</p>
    <TextLink href={href} class="pop-service-card__link max-md:!text-[15px]">{linkText}</TextLink>
  </div>
</article>

<style>
  .pop-service-card {
    box-shadow: 8px 8px 0 0 var(--pop-card-shadow-color);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .pop-service-card__title {
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    line-height: 1.25;
    hyphens: auto;
    -webkit-hyphens: auto;
    overflow-wrap: break-word;
    word-break: normal;
  }
  .pop-service-card__link {
    margin-top: auto;
  }
  .pop-service-card__number {
    text-shadow: 4px 4px 0 var(--pop-number-shadow-color);
  }
  @media (min-width: 768px) {
    .pop-service-card:hover,
    .pop-service-card:focus-within {
      transform: translate(-4px, -4px) rotate(-0.4deg);
      box-shadow: 12px 12px 0 0 var(--pop-fuchsia);
    }
  }
  @media (max-width: 767px) {
    .pop-service-card {
      flex-direction: row;
      align-items: stretch;
      box-shadow: 6px 6px 0 0 var(--pop-card-shadow-color);
    }
    .pop-service-card:hover,
    .pop-service-card:focus-within {
      box-shadow: 8px 8px 0 0 var(--pop-fuchsia);
    }
    .pop-service-card__number {
      text-shadow: 3px 3px 0 var(--pop-number-shadow-color);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pop-service-card {
      transition: none;
    }
    .pop-service-card:hover,
    .pop-service-card:focus-within {
      transform: none;
    }
  }
</style>

<!-- Utility rules extracted from kieks.me Tailwind 3; consumer independent. -->
<style>
@layer kieksme-website-reset {
:where(*) { box-sizing: border-box; }
:where([class*="border"]) { border-style: solid; border-width: 0; }
:where(h1,h2,h3,h4,p,figure) { margin: 0; }
:where(button) { background: transparent; text-align: inherit; font: inherit; }
:where(a) { text-decoration: inherit; }
}

@layer kieksme-website-utilities {
.pointer-events-none {
    pointer-events: none
}
.absolute {
    position: absolute
}
.relative {
    position: relative
}
.left-\[120px\] {
    left: 120px
}
.top-0 {
    top: 0px
}
.flex {
    display: flex
}
.h-\[132px\] {
    height: 132px
}
.h-full {
    height: 100%
}
.w-\[300px\] {
    width: 300px
}
.w-full {
    width: 100%
}
.flex-1 {
    flex: 1 1 0%
}
.transform {
    transform: translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y))
}
.flex-col {
    flex-direction: column
}
.gap-3 {
    gap: 0.75rem
}
.overflow-hidden {
    overflow: hidden
}
.border-\[3px\] {
    border-width: 3px
}
.border-b-\[3px\] {
    border-bottom-width: 3px
}
.border-\[var\(--ink\)\] {
    border-color: var(--ink)
}
.bg-\[var\(--surface\)\] {
    background-color: var(--surface)
}
.object-cover {
    object-fit: cover
}
.px-6 {
    padding-left: 1.5rem;
    padding-right: 1.5rem
}
.pb-\[26px\] {
    padding-bottom: 26px
}
.pl-6 {
    padding-left: 1.5rem
}
.pt-\[18px\] {
    padding-top: 18px
}
.pt-\[22px\] {
    padding-top: 22px
}
.font-heading {
    font-family: var(--aw-font-heading, "Hanken Grotesk"), ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji"
}
.text-\[80px\] {
    font-size: 80px
}
.text-lg {
    font-size: 1.125rem;
    line-height: 1.75rem
}
.font-black {
    font-weight: 900
}
.font-extrabold {
    font-weight: 800
}
.leading-7 {
    line-height: 1.75rem
}
.leading-\[normal\] {
    line-height: normal
}
.opacity-25 {
    opacity: 0.25
}
.shadow {
    --tw-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
    --tw-shadow-colored: 0 1px 3px 0 var(--tw-shadow-color), 0 1px 2px -1px var(--tw-shadow-color);
    box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow)
}
.transition {
    transition-property: color, background-color, border-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 150ms
}
@media not all and (min-width: 768px) {
    .max-md\:flex {
        display: flex
    }
    .max-md\:hidden {
        display: none
    }
    .max-md\:h-auto {
        height: auto
    }
    .max-md\:w-\[84px\] {
        width: 84px
    }
    .max-md\:shrink-0 {
        flex-shrink: 0
    }
    .max-md\:justify-center {
        justify-content: center
    }
    .max-md\:gap-2 {
        gap: 0.5rem
    }
    .max-md\:border-b-0 {
        border-bottom-width: 0px
    }
    .max-md\:border-r-\[3px\] {
        border-right-width: 3px
    }
    .max-md\:px-4 {
        padding-left: 1rem;
        padding-right: 1rem
    }
    .max-md\:pb-4 {
        padding-bottom: 1rem
    }
    .max-md\:pb-\[18px\] {
        padding-bottom: 18px
    }
    .max-md\:pl-0 {
        padding-left: 0px
    }
    .max-md\:pt-4 {
        padding-top: 1rem
    }
    .max-md\:pt-\[14px\] {
        padding-top: 14px
    }
    .max-md\:\!text-\[15px\] {
        font-size: 15px !important
    }
    .max-md\:text-\[40px\] {
        font-size: 40px
    }
}
}
</style>
