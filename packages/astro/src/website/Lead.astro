---
export interface Props {
  size?: 'l' | 'm';
  tone?: 'primary' | 'secondary' | 'onColor';
  class?: string;
}

const { size = 'l', tone = 'secondary', class: className = '' } = Astro.props;
const sizes = { l: 'text-lg leading-7 md:text-[22px] md:leading-8', m: 'text-lg leading-7' };
const tones = {
  primary: 'var(--text-primary)',
  secondary: 'var(--text-secondary)',
  onColor: 'inherit',
};
---

<p class:list={['font-sans font-normal', sizes[size], className]} style={`color: ${tones[tone]};`}>
  <slot />
</p>

<!-- Utility rules extracted from kieks.me Tailwind 3; consumer independent. -->
<style>
@layer kieksme-website-reset {
:where(*) { box-sizing: border-box; }
:where([class*="border"]) { border-style: solid; border-width: 0; }
:where(h1,h2,h3,h4,p,figure) { margin: 0; }
:where(button) { background: transparent; text-align: inherit; font: inherit; }
:where(a) { text-decoration: inherit; }
}

@layer kieksme-website-utilities {
.font-sans {
    font-family: var(--aw-font-sans, "Source Sans 3"), ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji"
}
.text-lg {
    font-size: 1.125rem;
    line-height: 1.75rem
}
.font-normal {
    font-weight: 400
}
.leading-7 {
    line-height: 1.75rem
}
@media (min-width: 768px) {
    .md\:text-\[22px\] {
        font-size: 22px
    }
    .md\:leading-8 {
        line-height: 2rem
    }
}
}
</style>
