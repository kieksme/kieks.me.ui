---
/**
 * Pop Button — SPEC §1.3 / §8
 * variant: primary (aqua) | secondary (surface) | aqua
 * shadow: fuchsia | aqua
 */
import type { HTMLAttributes } from 'astro/types';

export interface Props extends Omit<HTMLAttributes<'button'>, 'class' | 'size'> {
  variant?: 'primary' | 'secondary' | 'aqua';
  shadow?: 'fuchsia' | 'aqua';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  text?: string;
  icon?: string;
  type?: 'button' | 'submit' | 'reset';
  target?: string;
  class?: string;
}

const {
  variant = 'primary',
  shadow = 'fuchsia',
  size = 'md',
  href,
  text = await Astro.slots.render('default'),
  icon = '',
  type,
  target,
  class: className = '',
  ...nativeAttributes
} = Astro.props;
// Original website entries did not forward ancestor Astro scope IDs.
const attributes = Object.fromEntries(Object.entries(nativeAttributes).filter(([name]) => !name.startsWith('data-astro-cid-')));

const shadowColor = shadow === 'aqua' ? 'var(--pop-aqua)' : 'var(--pop-fuchsia)';
const sizes = {
  sm: 'text-base px-[26px] py-[15px]',
  md: 'text-lg px-[26px] py-[15px]',
  lg: 'text-xl px-[26px] py-[15px]',
};
const variants = {
  primary: 'bg-[var(--pop-aqua)] text-[var(--pop-navy)]',
  /* Solid white keeps contrast in light and dark; fuchsia offset matches primary Pop-Art weight. */
  secondary: 'bg-[var(--pop-white)] text-[var(--pop-navy)]',
  aqua: 'bg-[var(--pop-aqua)] text-[var(--pop-navy)]',
};
const cls = [
  'pop-btn inline-flex items-center justify-center font-heading font-extrabold leading-none border-[3px] border-[var(--ink)] cursor-pointer transition-[transform,box-shadow] duration-150',
  sizes[size],
  variants[variant],
  className,
].join(' ');
const style = `--pop-shadow: ${shadowColor}; box-shadow: 6px 6px 0 0 ${shadowColor};`;
---

{
  type === 'button' || type === 'submit' || type === 'reset' || !href ? (
    <button {...attributes} type={type ?? 'button'} class={cls} style={style}>
      {text ? <Fragment set:html={text} /> : <slot />}
      <slot name="icon" />
    </button>
  ) : (
    <a {...attributes} href={href} class={cls} style={style} {...(target ? { target, rel: 'noopener noreferrer' } : {})}>
      {text ? <Fragment set:html={text} /> : <slot />}
      <slot name="icon" />
    </a>
  )
}

<style>
  .pop-btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 0 var(--pop-shadow) !important;
  }
  .pop-btn:active {
    transform: translate(4px, 4px);
    box-shadow: 2px 2px 0 0 var(--pop-shadow) !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .pop-btn:hover,
    .pop-btn:active {
      transform: none;
    }
  }
</style>

<!-- Utility rules extracted from kieks.me Tailwind 3; consumer independent. -->
<style>
@layer kieksme-website-reset {
:where(*) { box-sizing: border-box; }
:where([class*="border"]) { border-style: solid; border-width: 0; }
:where(h1,h2,h3,h4,p,figure) { margin: 0; }
:where(button) { background: transparent; text-align: inherit; font: inherit; }
:where(a) { text-decoration: inherit; }
}

@layer kieksme-website-utilities {
.-mr-0\.5 {
    margin-right: -0.125rem
}
.ml-1 {
    margin-left: 0.25rem
}
.inline-block {
    display: inline-block
}
.inline-flex {
    display: inline-flex
}
.h-5 {
    height: 1.25rem
}
.w-5 {
    width: 1.25rem
}
.transform {
    transform: translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y))
}
.cursor-pointer {
    cursor: pointer
}
.items-center {
    align-items: center
}
.justify-center {
    justify-content: center
}
.border-\[3px\] {
    border-width: 3px
}
.border-\[var\(--ink\)\] {
    border-color: var(--ink)
}
.bg-\[var\(--pop-aqua\)\] {
    background-color: var(--pop-aqua)
}
.bg-\[var\(--pop-white\)\] {
    background-color: var(--pop-white)
}
.px-\[26px\] {
    padding-left: 26px;
    padding-right: 26px
}
.py-\[15px\] {
    padding-top: 15px;
    padding-bottom: 15px
}
.font-heading {
    font-family: var(--aw-font-heading, "Hanken Grotesk"), ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji"
}
.text-base {
    font-size: 1rem;
    line-height: 1.5rem
}
.text-lg {
    font-size: 1.125rem;
    line-height: 1.75rem
}
.text-xl {
    font-size: 1.25rem;
    line-height: 1.75rem
}
.font-extrabold {
    font-weight: 800
}
.leading-none {
    line-height: 1
}
.text-\[var\(--pop-navy\)\] {
    color: var(--pop-navy)
}
.shadow {
    --tw-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
    --tw-shadow-colored: 0 1px 3px 0 var(--tw-shadow-color), 0 1px 2px -1px var(--tw-shadow-color);
    box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow)
}
.transition-\[transform\2c box-shadow\] {
    transition-property: transform,box-shadow;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 150ms
}
.duration-150 {
    transition-duration: 150ms
}
}
</style>

<style>.pop-btn[hidden] { display: none !important; } .pop-btn:disabled { opacity: .5; cursor: not-allowed; }</style>
