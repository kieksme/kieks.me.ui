---
/**
 * Brand logo — horizontal wordmark keeps finger clear of the „k“.
 * Finger tip/wiggle is CSS-only (load + hover), disabled under prefers-reduced-motion.
 */
import circleLogo from './assets/kieks.me-single-circle.svg?url';
import circleLogoDark from './assets/kieks.me-single-circle-dark.svg?url';

export interface Props {
  lightSrc?: string;
  darkSrc?: string;
  variant?: 'auto' | 'light' | 'dark';
  size?: 'sm' | 'md' | 'hero';
  layout?: 'mark' | 'horizontal';
  isAnimated?: boolean;
  class?: string;
}

const { lightSrc = circleLogo, darkSrc = circleLogoDark, variant = 'auto', size = 'md', layout = 'mark', isAnimated = true, class: className = '' } = Astro.props;
const markSizes = {
  sm: { dimension: 44, class: 'h-11 w-11' },
  md: { dimension: 56, class: 'h-14 w-14' },
  hero: { dimension: 520, class: 'h-auto w-full max-w-[520px]' },
};
const wordmarkSizes = {
  /* Extra gap keeps the finger tip clear of the „k“, especially on mobile. */
  sm: { mark: 30, text: 'text-[1.35rem]', gap: 'gap-3' },
  md: { mark: 40, text: 'text-[1.75rem]', gap: 'gap-3.5' },
  hero: { mark: 72, text: 'text-[3rem]', gap: 'gap-4' },
};
const dimensions = markSizes[size];
const word = wordmarkSizes[size];
---

<span
  class:list={[
    'brand-logo inline-flex shrink-0 items-center',
    layout === 'horizontal' && ['brand-logo--horizontal', word.gap],
    { 'brand-logo--animated': isAnimated },
    className,
  ]}
  data-logo-variant={variant}
  data-logo-layout={layout}
>
  {
    layout === 'mark' ? (
      <>
        {(variant === 'auto' || variant === 'light') && (
          <img
            src={lightSrc}
            alt="kieks.me"
            width={dimensions.dimension}
            height={dimensions.dimension}
            class:list={[
              'brand-logo__mark aspect-square object-contain',
              dimensions.class,
              variant === 'auto' && 'dark:hidden',
            ]}
            decoding="async"
          />
        )}
        {(variant === 'auto' || variant === 'dark') && (
          <img
            src={darkSrc}
            alt={variant === 'dark' ? 'kieks.me' : ''}
            aria-hidden={variant === 'auto' ? 'true' : undefined}
            width={dimensions.dimension}
            height={dimensions.dimension}
            class:list={[
              'brand-logo__mark aspect-square object-contain',
              dimensions.class,
              variant === 'auto' && 'hidden dark:block',
            ]}
            decoding="async"
          />
        )}
      </>
    ) : (
      <>
        {/* Solid navy disc (no aqua ring) so the header stays clean in dark mode; finger never overlaps „k“. */}
        <span class="brand-logo__finger relative inline-flex shrink-0" aria-hidden="true">
          <img
            src={lightSrc}
            alt=""
            width={word.mark}
            height={word.mark}
            class="brand-logo__mark h-auto w-auto object-contain"
            style={`width:${word.mark}px;height:${word.mark}px;`}
            decoding="async"
          />
        </span>
        <span
          class:list={['brand-logo__word font-heading font-black lowercase leading-none tracking-[-0.04em]', word.text]}
          style="color: var(--text-primary);"
        >
          kieks<span style="color: var(--pop-fuchsia);">.me</span>
        </span>
      </>
    )
  }
</span>

<style>
  .brand-logo--animated .brand-logo__mark {
    transform-origin: 70% 55%;
    animation: brand-finger-tip 1.1s cubic-bezier(0.3, 1.4, 0.5, 1) both;
  }
  .brand-logo--animated:hover .brand-logo__mark,
  .brand-logo--animated:focus-within .brand-logo__mark {
    animation: brand-finger-wiggle 0.55s ease-in-out;
  }
  /* Horizontal wordmark: rotate only so the fingertip never slides into the „k“. */
  .brand-logo--horizontal.brand-logo--animated .brand-logo__mark {
    transform-origin: 55% 55%;
    animation: brand-finger-tip-safe 1.1s cubic-bezier(0.3, 1.4, 0.5, 1) both;
  }
  .brand-logo--horizontal.brand-logo--animated:hover .brand-logo__mark,
  .brand-logo--horizontal.brand-logo--animated:focus-within .brand-logo__mark {
    animation: brand-finger-wiggle-safe 0.55s ease-in-out;
  }
  @keyframes brand-finger-tip {
    0% {
      transform: translateX(-4px) rotate(-6deg);
      opacity: 0.6;
    }
    55% {
      transform: translateX(3px) rotate(4deg);
    }
    100% {
      transform: translateX(0) rotate(0deg);
      opacity: 1;
    }
  }
  @keyframes brand-finger-wiggle {
    0%,
    100% {
      transform: translateX(0) rotate(0deg);
    }
    35% {
      transform: translateX(3px) rotate(5deg);
    }
    70% {
      transform: translateX(-2px) rotate(-3deg);
    }
  }
  @keyframes brand-finger-tip-safe {
    0% {
      transform: rotate(-8deg);
      opacity: 0.7;
    }
    55% {
      transform: rotate(5deg);
    }
    100% {
      transform: rotate(0deg);
      opacity: 1;
    }
  }
  @keyframes brand-finger-wiggle-safe {
    0%,
    100% {
      transform: rotate(0deg);
    }
    35% {
      transform: rotate(6deg);
    }
    70% {
      transform: rotate(-4deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .brand-logo--animated .brand-logo__mark,
    .brand-logo--animated:hover .brand-logo__mark,
    .brand-logo--animated:focus-within .brand-logo__mark {
      animation: none;
    }
  }
</style>

<!-- Utility rules extracted from kieks.me Tailwind 3; consumer independent. -->
<style>
@layer kieksme-website-reset {
:where(*) { box-sizing: border-box; }
:where([class*="border"]) { border-style: solid; border-width: 0; }
:where(h1,h2,h3,h4,p,figure) { margin: 0; }
:where(button) { background: transparent; text-align: inherit; font: inherit; }
:where(a) { text-decoration: inherit; }
}

@layer kieksme-website-utilities {
.relative {
    position: relative
}
.inline-flex {
    display: inline-flex
}
.hidden {
    display: none
}
.aspect-square {
    aspect-ratio: 1 / 1
}
.h-11 {
    height: 2.75rem
}
.h-14 {
    height: 3.5rem
}
.h-auto {
    height: auto
}
.w-11 {
    width: 2.75rem
}
.w-14 {
    width: 3.5rem
}
.w-auto {
    width: auto
}
.w-full {
    width: 100%
}
.max-w-\[520px\] {
    max-width: 520px
}
.shrink-0 {
    flex-shrink: 0
}
.transform {
    transform: translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y))
}
.items-center {
    align-items: center
}
.gap-3 {
    gap: 0.75rem
}
.gap-3\.5 {
    gap: 0.875rem
}
.gap-4 {
    gap: 1rem
}
.object-contain {
    object-fit: contain
}
.font-heading {
    font-family: var(--aw-font-heading, "Hanken Grotesk"), ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji"
}
.text-\[1\.35rem\] {
    font-size: 1.35rem
}
.text-\[1\.75rem\] {
    font-size: 1.75rem
}
.text-\[3rem\] {
    font-size: 3rem
}
.font-black {
    font-weight: 900
}
.lowercase {
    text-transform: lowercase
}
.leading-none {
    line-height: 1
}
.tracking-\[-0\.04em\] {
    letter-spacing: -0.04em
}
.ring {
    --tw-ring-offset-shadow: var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);
    --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(3px + var(--tw-ring-offset-width)) var(--tw-ring-color);
    box-shadow: var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000)
}
.dark\:block:is(:global(.dark) *) {
    display: block
}
.dark\:hidden:is(:global(.dark) *) {
    display: none
}
}
</style>

<style>
:global([data-theme="dark"]) [data-logo-variant="auto"] .dark\:hidden {display:none}
:global([data-theme="dark"]) [data-logo-variant="auto"] .dark\:block {display:block}
</style>
